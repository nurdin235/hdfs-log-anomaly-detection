": {
      "maxDuration": 60,
      "includeFiles": "model/**",
      "excludeFiles": "{.git,.ipynb_checkpoints,**/__pycache__,alerts,dashboard,scripts,src}/**|*.{csv,ipynb,pptx,docx,png,txt}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
