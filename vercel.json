{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/analyze.py": {
      "maxDuration": 60,
      "includeFiles": "{model/**,src/**}",
      "excludeFiles": "{.git/**,.ipynb_checkpoints/**,**/__pycache__/**,alerts/**,dashboard/**,scripts/**,assets/**,*.ipynb,*.pptx,*.docx,*.png,*.txt,*.csv}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
